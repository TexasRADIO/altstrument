---
// altstrument mark: a landscape DIP chip with "ALT" knocked out of the package.
// Drawn on a 32-unit grid; the viewBox is cropped to the mark's own bounds (26x22 units) so it
// lines up flush with adjacent text. Render it at 26x22px (or 2x): straight edges sit on whole
// units so they stay sharp at 1x and 2x. Pins are 1 unit wide, so their centers are on .5.
// public/favicon.svg is the pinless, enlarged variant of this mark.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
// Mask ids must be unique if the mark renders more than once on a page.
const id = `logo-${Math.random().toString(36).slice(2, 8)}`;
---
<svg class={className} viewBox="3 5 26 22" aria-hidden="true" focusable="false">
  <defs>
    <mask id={`${id}-alt`}>
      <rect width="32" height="32" fill="#fff" />
      <path d="M7 21V13L9 11H11L13 13V21H11V18H9V21ZM9 13V16H11V13Z" fill="#000" fill-rule="evenodd" />
      <path d="M15 11H17V19H19V21H15Z" fill="#000" />
      <path d="M19 11H25V13H23V21H21V13H19Z" fill="#000" />
    </mask>
  </defs>
  <path d="M8.5 5V8M13.5 5V8M18.5 5V8M23.5 5V8M8.5 24V27M13.5 24V27M18.5 24V27M23.5 24V27" fill="none" stroke="currentColor" stroke-width="1" />
  <rect x="3" y="8" width="26" height="16" rx="3" fill="currentColor" mask={`url(#${id}-alt)`} />
</svg>
