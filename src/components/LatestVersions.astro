---
import type { RecentVersion } from '@/lib/catalog';
import { isoDate, versionAnchor } from '@/lib/catalog';
import DeviceThumb from './DeviceThumb.astro';
interface Props { rows: RecentVersion[] }
const { rows } = Astro.props;
---
{rows.length > 0 && (
  <section aria-labelledby="latest">
    <h2 id="latest" class="flex items-baseline justify-between gap-2 border-b border-line pb-1 text-lg">
      Latest
      <a href="/recent" class="text-sm font-normal">All recent →</a>
    </h2>
    <ol class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {rows.map((r, i) => (
        /* Phones show the first 3 so search stays near the top. */
        <li class={i >= 3 ? 'hidden sm:block' : undefined}>
          {/* The firmware link covers the card; the device link sits above it. */}
          <article class="relative flex h-full overflow-hidden rounded border border-line bg-surface hover:border-line-strong">
            <div class="w-20 shrink-0 self-stretch border-r border-line">
              <DeviceThumb device={r.device} small />
            </div>
            <div class="flex min-w-0 flex-1 flex-col gap-0.5 px-3 py-2 text-sm">
              <h3 class="truncate text-base">
                <a href={`${r.firmware.url}#${versionAnchor(r.version.version)}`} class="text-fg no-underline after:absolute after:inset-0 after:content-[''] hover:underline">{r.firmware.data.name}</a>
              </h3>
              <p class="truncate text-muted">for <a href={r.device.url} class="relative">{r.device.data.name}</a></p>
              <p class="mt-auto flex items-baseline justify-between gap-3 text-xs">
                <span class="mono truncate font-medium">{r.version.version}</span>
                <time class="mono shrink-0 text-muted" datetime={isoDate(r.date)}>{isoDate(r.date)}</time>
              </p>
            </div>
          </article>
        </li>
      ))}
    </ol>
  </section>
)}
