---
import Badge from './Badge.astro';
import { SOURCE_INFO } from '@/lib/labels';
import type { SourceStatus } from '@/content/schema';
interface Props { status: SourceStatus }
const { status } = Astro.props;
const info = SOURCE_INFO[status];
---
<Badge tone={info.tone} title={`Source: ${info.desc}`}>Source: {info.label}</Badge>
