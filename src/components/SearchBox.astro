---
import { CATEGORIES, CATEGORY_LABELS } from '@/content/schema';
export interface IndexEntry {
  id: string;
  name: string;
  manufacturer: string;
  category: string;
  tagline?: string;
  firmwareCount: number;
  /** Firmware names, so searching "octabam" finds its device. */
  firmwares: string;
}
interface Props { index: IndexEntry[]; categories: string[] }
const { index, categories } = Astro.props;
const json = JSON.stringify(index).replace(/</g, '\\u003c');
---
<form id="device-search" role="search" class="flex flex-col gap-2 sm:flex-row sm:items-end" hidden>
  <div class="flex-1">
    <label for="q" class="block text-sm font-medium">Search devices</label>
    <input
      id="q"
      type="search"
      autocomplete="off"
      placeholder="Name, manufacturer, firmware, tagline"
      class="mt-1 w-full rounded border border-line-strong bg-surface px-3 py-2 text-base text-fg placeholder:text-muted"
    />
  </div>
  <div class="grid grid-cols-2 gap-2 sm:flex">
    <div class="col-span-2 min-w-0 sm:col-span-1">
      <label for="cat" class="block text-sm font-medium">Category</label>
      <select id="cat" class="mt-1 w-full rounded border border-line-strong bg-surface px-2 py-2 text-base text-fg sm:w-auto sm:px-3">
        <option value="">All categories</option>
        {categories.map((c) => <option value={c}>{CATEGORY_LABELS[c as (typeof CATEGORIES)[number]]}</option>)}
      </select>
    </div>
    <div class="min-w-0">
      <label for="group" class="block text-sm font-medium">Group by</label>
      <select id="group" class="mt-1 w-full rounded border border-line-strong bg-surface px-2 py-2 text-base text-fg sm:w-auto sm:px-3">
        <option value="manufacturer">Manufacturer</option>
        <option value="category">Category</option>
      </select>
    </div>
    <div class="min-w-0">
      <label for="sort" class="block text-sm font-medium">Sort by</label>
      <select id="sort" class="mt-1 w-full rounded border border-line-strong bg-surface px-2 py-2 text-base text-fg sm:w-auto sm:px-3">
        <option value="popularity">Popularity</option>
        <option value="name">Name</option>
        <option value="updated">Recently updated</option>
      </select>
    </div>
  </div>
</form>
<p id="search-status" class="mt-2 min-h-[1.5em] text-sm text-muted" role="status" aria-live="polite" hidden></p>
<script is:inline>
  // Runs before the lists are parsed so there is no flash of the wrong grouping.
  // ?group= / ?sort= win over localStorage (groupBy / sortBy). Defaults: manufacturer, popularity.
  (function () {
    function pick(param, key, allowed, fallback) {
      var v = null;
      try { v = new URLSearchParams(location.search).get(param); } catch (e) {}
      if (allowed.indexOf(v) === -1) {
        v = null;
        try { v = localStorage.getItem(key); } catch (e) {}
      }
      return allowed.indexOf(v) === -1 ? fallback : v;
    }
    var root = document.documentElement;
    root.setAttribute('data-grouping', pick('group', 'groupBy', ['manufacturer', 'category'], 'manufacturer'));
    root.setAttribute('data-sorting', pick('sort', 'sortBy', ['popularity', 'name', 'updated'], 'popularity'));

    // Reorders sections (and their jump links) and cards using data-count / data-name /
    // data-updated. Server HTML is already in popularity order. index.astro calls this
    // right after the lists so a stored non-default sort is applied before first paint.
    var coll = new Intl.Collator('en', { sensitivity: 'base', numeric: true });
    window.fwSort = function (mode) {
      function attr(el, n) { return el.getAttribute(n) || ''; }
      function cmp(a, b) {
        var byName = coll.compare(attr(a, 'data-name'), attr(b, 'data-name'));
        if (mode === 'name') return byName;
        if (mode === 'updated') {
          var au = attr(a, 'data-updated'), bu = attr(b, 'data-updated');
          if (au !== bu) return !au ? 1 : !bu ? -1 : au < bu ? 1 : -1;
          return byName;
        }
        return (Number(attr(b, 'data-count')) - Number(attr(a, 'data-count'))) || byName;
      }
      function kids(parent, sel) {
        return Array.prototype.filter.call(parent.children, function (c) { return c.matches(sel); });
      }
      function put(parent, list) { list.sort(cmp).forEach(function (c) { parent.appendChild(c); }); }
      Array.prototype.forEach.call(document.querySelectorAll('[data-group-view]'), function (view) {
        var first = view.querySelector('[data-group]');
        if (!first) return;
        var secs = kids(first.parentNode, '[data-group]');
        put(first.parentNode, secs);
        var nav = view.querySelector('nav ul');
        if (nav) {
          var byKey = {};
          kids(nav, '[data-jump]').forEach(function (li) { byKey[li.getAttribute('data-jump')] = li; });
          secs.forEach(function (s) { var li = byKey[s.getAttribute('data-group')]; if (li) nav.appendChild(li); });
        }
        secs.forEach(function (s) {
          var list = s.querySelector('ul');
          if (list) put(list, kids(list, '[data-device]'));
        });
      });
    };
  })();
</script>
<script type="application/json" id="device-index" set:html={json}></script>
<script is:inline>
  function init() {
    var form = document.getElementById('device-search');
    var raw = document.getElementById('device-index');
    if (!form || !raw) return;
    var index;
    try { index = JSON.parse(raw.textContent); } catch (e) { return; }
    var q = document.getElementById('q');
    var cat = document.getElementById('cat');
    var group = document.getElementById('group');
    var sort = document.getElementById('sort');
    var status = document.getElementById('search-status');
    var none = document.getElementById('no-results');
    var hay = {}, catOf = {};
    index.forEach(function (d) {
      hay[d.id] = [d.name, d.manufacturer, d.tagline || '', d.firmwares || ''].join(' ').toLowerCase();
      catOf[d.id] = d.category;
    });
    var items = Array.prototype.slice.call(document.querySelectorAll('[data-device]'));
    var groups = Array.prototype.slice.call(document.querySelectorAll('[data-group]'));
    var jumps = {};
    Array.prototype.forEach.call(document.querySelectorAll('[data-jump]'), function (li) {
      jumps[li.getAttribute('data-jump')] = li;
    });
    var total = index.length;
    // Every card exists once per grouping. Visibility is applied to all copies;
    // the match count comes from the index, so it is never doubled.
    function apply() {
      var terms = q.value.toLowerCase().split(/\s+/).filter(Boolean);
      var c = cat.value;
      var ok = {}, shown = 0;
      index.forEach(function (d) {
        var m = (!c || catOf[d.id] === c) && terms.every(function (t) { return hay[d.id].indexOf(t) !== -1; });
        ok[d.id] = m;
        if (m) shown++;
      });
      items.forEach(function (li) { li.hidden = !ok[li.getAttribute('data-device')]; });
      groups.forEach(function (g) {
        var all = g.querySelectorAll('[data-device]').length;
        var vis = g.querySelectorAll('[data-device]:not([hidden])').length;
        g.hidden = vis === 0;
        var label = vis === all ? String(vis) : vis + ' of ' + all;
        var n = g.querySelector('[data-group-count]');
        if (n) {
          n.textContent = label;
          n.setAttribute('aria-label', (vis === all ? '' : vis + ' of ') + all + (all === 1 ? ' device' : ' devices'));
        }
        var j = jumps[g.getAttribute('data-group')];
        if (j) {
          j.hidden = vis === 0;
          var jn = j.querySelector('[data-jump-count]');
          if (jn) jn.textContent = String(vis);
        }
      });
      var filtering = terms.length > 0 || !!c;
      status.hidden = !filtering;
      status.textContent = filtering ? shown + ' of ' + total + ' devices match' : '';
      if (none) none.hidden = shown !== 0;
    }
    var root = document.documentElement;
    group.value = root.getAttribute('data-grouping') === 'category' ? 'category' : 'manufacturer';
    sort.value = root.getAttribute('data-sorting') || 'popularity';
    function remember(param, key, value) {
      try { localStorage.setItem(key, value); } catch (e) {}
      try {
        var u = new URL(location.href);
        u.searchParams.set(param, value);
        history.replaceState(history.state, '', u.pathname + u.search + u.hash);
      } catch (e) {}
    }
    function setGroup() {
      var g = group.value === 'category' ? 'category' : 'manufacturer';
      root.setAttribute('data-grouping', g);
      remember('group', 'groupBy', g);
    }
    function setSort() {
      var m = sort.value;
      if (m !== 'name' && m !== 'updated') m = 'popularity';
      root.setAttribute('data-sorting', m);
      window.fwSort(m);
      remember('sort', 'sortBy', m);
    }
    form.hidden = false;
    form.addEventListener('submit', function (e) { e.preventDefault(); });
    q.addEventListener('input', apply);
    cat.addEventListener('change', apply);
    group.addEventListener('change', setGroup);
    sort.addEventListener('change', setSort);
    var m = /[?&]q=([^&]*)/.exec(location.search);
    if (m) { try { q.value = decodeURIComponent(m[1].replace(/\+/g, ' ')); } catch (e) {} apply(); }
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
</script>
